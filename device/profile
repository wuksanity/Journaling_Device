# Contents for ~/.profile on the device.
#
# It must be .profile, not .bash_profile: Raspberry Pi OS ships a .profile and
# bash ignores .bash_profile when one exists.

if [ "$(tty)" = "/dev/tty1" ]; then
    tmux new-session -A -s journal "python3 $HOME/journal.py"

    # The session ended -- either deploy.ps1 killed it, or the app exited.
    # Ending the login shell lets console autologin respawn it, which relaunches
    # the app. The read is an escape hatch: without it, an app that crashes on
    # startup would put tty1 into a respawn loop with no way to get a shell on
    # the console to fix it.
    echo
    if read -r -t 5 -p "journal exited. enter within 5s for a shell... "; then
        exec bash -l
    fi
    exit
fi

if [ -n "$SSH_CONNECTION" ] && [ -z "$TMUX" ]; then
    tmux attach -t journal 2>/dev/null
fi
