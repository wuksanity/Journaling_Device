#!/bin/bash
# Blink out which screen the app is on, on demand, so the device is navigable
# with no display attached.
#
#     journal-led compass write|menu|browse|read|settings|hotspot|failed
#     journal-led which     print the LED being driven
#
# One flash means writing, two the menu, and so on; one long flash means
# something failed. Counting flashes is unambiguous in a way that judging a
# rhythm's tempo is not, and it means the LED is dark unless you have asked it
# something -- nothing blinks at you while you write.
#
# The LED is handed straight back to its normal Scroll Lock function afterwards,
# so the app borrows it for about two seconds and owns it the rest of the time
# not at all.
#
# Prefers a keyboard lock LED over the Pi's board light: it is under your
# fingers rather than in your bag. Scroll Lock is the natural pick, since
# nothing else in the system uses it.

set -u
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

pick_led() {
    for p in /sys/class/leds/*::scrolllock /sys/class/leds/*::numlock \
             /sys/class/leds/*::capslock; do
        [ -d "$p" ] && { printf '%s\n' "$p"; return 0; }
    done
    for p in /sys/class/leds/ACT /sys/class/leds/led0; do
        [ -d "$p" ] && { printf '%s\n' "$p"; return 0; }
    done
    return 1
}

LED=$(pick_led) || exit 0        # no LED is not an error; just do nothing

# What this LED does when the app is not borrowing it.
default_trigger() {
    case "$LED" in
        *scrolllock) echo "kbd-scrolllock" ;;
        *numlock)    echo "kbd-numlock" ;;
        *capslock)   echo "kbd-capslock" ;;
        *ACT|*led0)  echo "mmc0" ;;
        *)           echo "none" ;;
    esac
}

# Flash count per screen. The two you are in most often are the fewest to count.
compass_count() {
    case "$1" in
        write)    echo 1 ;;
        menu)     echo 2 ;;
        browse)   echo 3 ;;
        settings) echo 4 ;;
        read)     echo 5 ;;
        hotspot)  echo 6 ;;
        # A long single flash, distinct from any count: something went wrong.
        failed)   echo -1 ;;
        *)        echo 0 ;;
    esac
}

case "${1:-}" in
    compass)
        count=$(compass_count "${2:-}")
        [ "$count" -eq 0 ] && exit 2
        if [ "$count" -lt 0 ]; then
            # Failure: one long flash, unmistakably not a count.
            (
                echo none > "$LED/trigger" 2>/dev/null
                echo 0 > "$LED/brightness" 2>/dev/null
                sleep 0.5
                echo 1 > "$LED/brightness" 2>/dev/null
                sleep 1.6
                echo 0 > "$LED/brightness" 2>/dev/null
                echo "$(default_trigger)" > "$LED/trigger" 2>/dev/null \
                    || echo none > "$LED/trigger" 2>/dev/null
            ) >/dev/null 2>&1 &
            exit 0
        fi
        # Backgrounded and detached: this sleeps, and it is triggered by a
        # keypress. Blocking here would stall the keystroke loop the way syncing
        # on every newline used to.
        (
            echo none > "$LED/trigger" 2>/dev/null
            echo 0 > "$LED/brightness" 2>/dev/null
            sleep 0.5                        # a clear gap, so you know the count starts
            i=0
            while [ "$i" -lt "$count" ]; do
                echo 1 > "$LED/brightness" 2>/dev/null
                sleep 0.18
                echo 0 > "$LED/brightness" 2>/dev/null
                sleep 0.24
                i=$((i + 1))
            done
            sleep 0.4                        # and a clear gap after it ends
            # Brightness first, then the trigger. Writing brightness while a
            # trigger owns the LED clears that trigger straight back to none,
            # so the other order silently undoes the handback.
            echo 0 > "$LED/brightness" 2>/dev/null
            echo "$(default_trigger)" > "$LED/trigger" 2>/dev/null \
                || echo none > "$LED/trigger" 2>/dev/null
        ) >/dev/null 2>&1 &
        ;;

    which)
        printf '%s\n' "$LED"
        ;;

    release)
        echo 0 > "$LED/brightness" 2>/dev/null
        echo "$(default_trigger)" > "$LED/trigger" 2>/dev/null \
            || echo none > "$LED/trigger" 2>/dev/null
        ;;

    *)
        echo "usage: journal-led compass <screen> | which | release" >&2
        exit 2
        ;;
esac
